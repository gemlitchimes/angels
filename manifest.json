{
  "manifest_version": 3,
  "name": "angels — AI Studio",
  "short_name": "angels",
  "version": "1.0.0",
  "description": "Giao diện đêm tím cho Google AI Studio: sao trắng và bướm trắng bay, kính trong, nút bạc và tiếng chuông gió.",
  "permissions": ["storage"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "angels",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "content_scripts": [
    {
      "matches": ["https://aistudio.google.com/*"],
      "css": ["fonts.css", "theme.css"],
      "js": ["chime.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["fonts/*"], "matches": ["https://aistudio.google.com/*"] }
  ]
}
